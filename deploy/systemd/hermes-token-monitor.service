[Unit]
Description=Hermes Token Monitor
After=network.target

[Service]
Type=simple
# Security note: for production, consider creating a dedicated user
# and granting access to ~/.hermes/ via setfacl. Example:
#   useradd -r -s /sbin/nologin hermes
#   setfacl -R -m u:hermes:rwx ~/.hermes/token_monitor/
#   setfacl -m u:hermes:r ~/.hermes/state.db
# Then change User=root to User=hermes below.
User=root
WorkingDirectory=/root/.hermes/token_monitor
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/usr/bin/python3 /root/.hermes/token_monitor/server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
