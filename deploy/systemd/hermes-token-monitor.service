[Unit]
Description=Hermes Token Monitor
After=network.target

[Service]
Type=simple
# Run as a dedicated user instead of root for least-privilege security.
# Create user: useradd -r -s /sbin/nologin hermes
# Then grant read access to state.db: setfacl -m u:hermes:r ~/.hermes/state.db
User=hermes
WorkingDirectory=/root/.hermes/token_monitor
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/usr/bin/python3 /root/.hermes/token_monitor/server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
