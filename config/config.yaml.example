    base_url: ''
    api_key: ""
    timeout: 30
    extra_body: {}
  approval:
    provider: deepseek
    model: deepseek-v4-flash
    base_url: ''
    api_key: ""
    timeout: 30
    extra_body: {}
  mcp:
